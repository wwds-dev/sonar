<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the SONAR engine running when the app is not open.

  Runs the headless daemon (the headless flag), which drives the same sonar.core.Live
  the GUI does and writes the same state file. The point is uptime: a position
  priced at 14:05 has to settle against the 15:00 candle, and an app you quit at
  14:30 loses that hour permanently.

  Installed by scripts/install_agent.sh, which fills in EXEC, MAIN_PY,
  WORK_DIR, LOG_DIR and DATA_DIR, since launchd does not expand variables or ~
  in these fields. By default EXEC is the installed app's own binary and the
  MAIN_PY line is dropped; in checkout mode EXEC is the checkout's python and
  MAIN_PY its main.py.

  DATA_DIR is the installed app's state directory (Application Support). Run
  from a checkout the default is the checkout's own data/, and without this the
  agent keeps a second book beside the app's instead of the app's.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.netrunner3000.sonar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__EXEC__</string>
        <string>__MAIN_PY__</string>
        <string>--headless</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8787</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORK_DIR__</string>

    <!-- One book with the installed app: see sonar/paths.py (SONAR_DATA).
         SONAR_ALARM is pinned on: a per-job value beats a global
         launchctl setenv, which would otherwise silence the phone alarm
         (sonar/alarm.py alarm_mode; docs/specs/starved-engine.md A2). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>SONAR_DATA</key>
        <string>__DATA_DIR__</string>
        <key>SONAR_ALARM</key>
        <string>on</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it dies. ThrottleInterval stops a crash-loop from
         hammering the market APIs and getting the machine rate-limited. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- Loopback only. Nothing here should be reachable off the machine. -->
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/agent.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/agent.err.log</string>

    <!-- Standard: under Background + Nice 5 the agent missed its 4 s poll and
         took 3-24 s to answer on a loaded Mac
         (docs/audit/alarm-delivery-osascript-diagnosis.md section 4); it uses
         near-zero CPU. No Nice key (docs/adr/0006-agent-processtype-standard.md). -->
    <key>ProcessType</key>
    <string>Standard</string>
</dict>
</plist>
