# Copy to .env (git-ignored) beside main.py and fill in only what you want.
# Every line is optional: SONAR runs keyless and free without any of them.
# Names only; never commit real values.

# Alpaca PAPER trading (sonar/alpaca.py). Paper keys start with "PK"; anything else is refused.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional market-data providers (sonar/providers.py). Equities have no keyless
# second source, so a free Finnhub key is the highest-value one.
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# Optional LLM read (sonar/llm.py). ANTHROPIC_AUTH_TOKEN is read as an alternative.
ANTHROPIC_API_KEY=

# FRED (macro regime) is fetched keyless as CSV; it needs no key here.
